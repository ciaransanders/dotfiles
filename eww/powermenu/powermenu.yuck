
; Whether SSH mode (sshd + lid/sleep inhibitor) is currently on
(defpoll ssh_mode :interval "5s" :initial "false"
  "$HOME/.config/eww/scripts/ssh_mode.sh status")

(defwindow powermenu-closer [screen]
  :monitor screen
  :class "powermenu-closer"
  :stacking "fg"
  :geometry (geometry :width "100%" :height "100%")
  (closer :window "powermenu")
)

(defwindow powermenu [screen]
  :monitor screen
  :class "powermenu"
  :stacking "fg"
  :wm-ignore true
  :exclusive false
  :geometry (geometry :y "35%" :anchor "top center")
  (powermenu_widget)
)

; A single row of the powermenu: action label on the left, icon on the right
(defwidget powermenu_item [class label icon onclick]
  (eventbox :cursor "pointer"
    (button :class class :onclick onclick
      (box :orientation "horizontal" :space-evenly false :class "powermenu-item"
        (label :class "powermenu-label" :text label :halign "start" :hexpand true)
        (image :path "${home}/.config/eww/images/${icon}" :image-width 24 :fill-svg "#ebdbb2")
      )
    )
  )
)

(defwidget powermenu_widget []
  (box :orientation "vertical" :spacing 6 :space-evenly false :class "powermenu-box"
    (powermenu_item :class "poweroff" :label "Power off" :icon "power.svg"
      :onclick "bash -c '${closer_script} powermenu && poweroff'&")
    (powermenu_item :class "lock" :label "Lock" :icon "lock.svg"
      :onclick "bash -c '${closer_script} powermenu && hyprlock'&")
    (powermenu_item :class "launcher" :label "Launcher" :icon "rocket.svg"
      :onclick "bash -c '${closer_script} powermenu && rofi -show drun'&")
    (powermenu_item :class "ssh ${ssh_mode ? 'active' : ''}" :label "SSH mode${ssh_mode ? ' (on)' : ''}" :icon "ssh.svg"
      :onclick "bash -c '${closer_script} powermenu && ${home}/.config/eww/scripts/ssh_mode.sh toggle'&")
  )
)
